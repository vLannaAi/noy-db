{
  "name": "@noy-db/test-benchmarks",
  "version": "0.0.0",
  "private": true,
  "description": "Performance benchmarks",
  "type": "module",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "bench:vectors": "vitest run --config vitest.bench.config.ts src/vector-brute-force.bench.ts",
