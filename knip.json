{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"]
    },
    "packages/create-noy-db": {
      "ignore": ["templates/**"]
    },
    "packages/hub": {
      "entry": [
        "src/index.ts",
        "scripts/*.mjs",
        "__tests__/**/*.test-d.ts",
        "src/kernel/{to,on,at,in,by,ui,with}/index.ts",
        "src/**/active.ts",
        "src/kernel/util/index.ts",
        "src/with-fork/snapshots/index.ts",
        "src/with-party/session/index.ts",
        "src/with-party/team/index.ts",
        "src/with-shape/classified/index.ts",
        "src/with-shape/satellites/index.ts"
      ]
    }
  }
}
