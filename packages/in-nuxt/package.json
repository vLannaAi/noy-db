{
  "name": "@noy-db/in-nuxt",
  "version": "0.2.0-pre.25",
  "description": "Nuxt 4 module for noy-db — auto-imports, SSR-safe runtime plugin, and the @noy-db/in-pinia bridge",
  "license": "MIT",
  "author": "vLannaAi <vicio@lanna.ai>",
  "homepage": "https://github.com/vLannaAi/noy-db/tree/main/packages/in-nuxt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vLannaAi/noy-db.git",
    "directory": "packages/in-nuxt"
  },
  "bugs": {
    "url": "https://github.com/vLannaAi/noy-db/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@noy-db/hub": "workspace:*",
    "@noy-db/in-pinia": "workspace:*",
    "@noy-db/in-rest": "workspace:*",
    "@noy-db/in-vue": "workspace:*",
    "nuxt": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@noy-db/in-rest": {
      "optional": true
    }
  },
  "dependencies": {
    "@noy-db/in-devtools": "workspace:*"
  },
  "devDependencies": {
    "@noy-db/hub": "workspace:*",
    "@noy-db/in-pinia": "workspace:*",
    "@noy-db/in-rest": "workspace:*",
    "@noy-db/in-vue": "workspace:*",
    "@nuxt/kit": "^4.4.2",
    "@nuxt/schema": "^4.4.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "h3": "^1.13.0",
    "happy-dom": "^17.4.4",
    "nuxt": "^4.4.2",
    "vue": "^3.5.32"
  },
  "keywords": [
    "noy-db",
    "nuxt",
    "nuxt4",
    "module",
    "encryption",
    "zero-knowledge",
    "offline-first",
    "pinia",
    "vue"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
