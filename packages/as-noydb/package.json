{
  "name": "@noy-db/as-noydb",
  "version": "0.7.0-pre.9",
  "description": "Encrypted .noydb bundle export for noy-db — wraps writePod() with the RFC #249 canExportBundle authorization gate and ergonomic browser/node helpers. Sole member of the @noy-db/as-* encrypted tier — ciphertext in, ciphertext out.",
  "license": "MIT",
  "author": "vLannaAi <vicio@lanna.ai>",
  "homepage": "https://github.com/vLannaAi/noy-db/tree/main/packages/as-noydb#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vLannaAi/noy-db.git",
    "directory": "packages/as-noydb"
  },
  "bugs": {
    "url": "https://github.com/vLannaAi/noy-db/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@noy-db/hub": "workspace:^"
  },
  "devDependencies": {
    "@noy-db/hub": "workspace:*",
    "@noy-db/test-format-conformance": "workspace:*",
    "@types/node": "^22.0.0"
  },
  "keywords": [
    "noy-db",
    "as-noydb",
    "bundle",
    "backup",
    "encrypted",
    "zero-knowledge"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
