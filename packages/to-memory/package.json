{
  "name": "@noy-db/to-memory",
  "version": "0.6.0-pre.23",
  "description": "In-memory adapter for noy-db — ideal for testing, development, and ephemeral workloads",
  "license": "MIT",
  "author": "vLannaAi <vicio@lanna.ai>",
  "homepage": "https://github.com/vLannaAi/noy-db/tree/main/packages/to-memory#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vLannaAi/noy-db.git",
    "directory": "packages/to-memory"
  },
  "bugs": {
    "url": "https://github.com/vLannaAi/noy-db/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@noy-db/hub": "workspace:*"
  },
  "devDependencies": {
    "@noy-db/hub": "workspace:*",
    "@noy-db/test-adapter-conformance": "workspace:*"
  },
  "keywords": [
    "noy-db",
    "adapter",
    "in-memory",
    "memory",
    "storage",
    "testing",
    "encryption",
    "zero-knowledge"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
