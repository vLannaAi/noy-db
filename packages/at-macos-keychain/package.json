{
  "name": "@noy-db/at-macos-keychain",
  "version": "0.7.0-pre.8",
  "description": "macOS Keychain sealing key provider for noy-db managed-secret mode — AES-256-GCM under a 32-byte key stored in the user's login Keychain. Desktop-app provider in the at-* family; pairs with Touch ID via Keychain Access UI.",
  "license": "MIT",
  "author": "vLannaAi <vicio@lanna.ai>",
  "homepage": "https://github.com/vLannaAi/noy-db/tree/main/packages/at-macos-keychain#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vLannaAi/noy-db.git",
    "directory": "packages/at-macos-keychain"
  },
  "bugs": {
    "url": "https://github.com/vLannaAi/noy-db/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@napi-rs/keyring": "^1.1.0",
    "@noy-db/hub": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@napi-rs/keyring": {
      "optional": false
    }
  },
  "devDependencies": {
    "@napi-rs/keyring": "^1.1.0",
    "@noy-db/hub": "workspace:*",
    "@noy-db/on-shamir": "workspace:*",
    "@noy-db/test-sealer-conformance": "workspace:*",
    "@noy-db/to-memory": "workspace:*",
    "@types/node": "^22.0.0"
  },
  "keywords": [
    "noy-db",
    "at-macos-keychain",
    "sealing-key-provider",
    "managed-secret",
    "macos",
    "keychain",
    "aes-256-gcm",
    "rubber-hose-resistant",
    "encryption",
    "zero-knowledge"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
