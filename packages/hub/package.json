  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.typetest.json && tsc --noEmit -p tsconfig.tests.json",
    "typecheck:types": "tsc --noEmit -p tsconfig.typetest.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
