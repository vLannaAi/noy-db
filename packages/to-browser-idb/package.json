  },
  "peerDependencies": {
    "@noy-db/hub": "workspace:*"
  },
  "devDependencies": {
    "@noy-db/hub": "workspace:*",
    "@noy-db/test-adapter-conformance": "workspace:*",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^18.0.0"
  },
  "keywords": [
    "noy-db",
    "adapter",
    "browser",
