{
  "name": "@noy-db/in-vue",
  "version": "0.6.0-pre.8",
  "description": "Vue 3 / Nuxt composables for noy-db — reactive useNoydb, useCollection, useSync, and biometric plugin",
  "license": "MIT",
  "author": "vLannaAi <vicio@lanna.ai>",
  "homepage": "https://github.com/vLannaAi/noy-db/tree/main/packages/in-vue#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vLannaAi/noy-db.git",
    "directory": "packages/in-vue"
  },
  "bugs": {
    "url": "https://github.com/vLannaAi/noy-db/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@noy-db/hub": "workspace:*",
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@noy-db/hub": "workspace:*",
    "vue": "^3.5.32"
  },
  "keywords": [
    "noy-db",
    "vue",
    "vue3",
    "nuxt",
    "composables",
    "reactive",
    "encryption",
    "offline-first",
    "biometric",
    "webauthn"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
